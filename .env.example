# Copy this file to `.env` and adjust the values. `.env` is never committed.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# --- PostgreSQL ---
# POSTGRES_HOST is overridden to "db" inside Docker Compose.
# Use "localhost" to run the API or the tests directly on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deskpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deskpilot
# Separate database used by the test suite (created automatically, must end with "_test").
POSTGRES_TEST_DB=deskpilot_test

# --- Authentication ---
# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-with-32-plus-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- First admin (optional) ---
# If set, the first admin account is created on startup (if it does not exist yet).
FIRST_ADMIN_EMAIL=admin@deskpilot.dev
FIRST_ADMIN_PASSWORD=change-me-admin
FIRST_ADMIN_NAME=Administrator

# --- Demo data (development only) ---
# Password of the demo accounts created by: python -m app.scripts.seed_demo
DEMO_PASSWORD=change-me-demo
