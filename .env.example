# Copy this file to `.env` and adjust the values. `.env` is never committed.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# --- PostgreSQL ---
# POSTGRES_HOST is overridden to "db" inside Docker Compose.
# Use "localhost" to run the API or the tests directly on your machine.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=deskpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=deskpilot
# Separate database used by the test suite (created automatically, must end with "_test").
POSTGRES_TEST_DB=deskpilot_test
